@{
    ViewData["Title"] = "Ingresar Nombre";
}

<main class="popup-page">
    <section class="popup-panel popup-panel-nombre" aria-labelledby="nombre-titulo">
        <h1 id="nombre-titulo" class="popup-titulo">Ingresa tu nombre</h1>

        <form class="popup-form" method="post" action="@Url.Action("IngresarNombrePost", "Home")">
            <div class="popup-campo">
                <label for="nombre">Nombre:</label>
                <input class="popup-input" type="text" id="nombre" name="nombre" placeholder="Escribe tu nombre aquí" required>
            </div>

            <button class="boton-retro popup-submit" type="submit">Jugar</button>
        </form>
    </section>
</main>
